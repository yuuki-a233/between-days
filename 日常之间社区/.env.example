# 本地测试无需设置这些变量，直接运行启动脚本。
# 将此文件复制为 .env.local 可覆盖本地设置。
# APP_URL=http://localhost:3100
# DATA_DIR=./data
# OWNER_EMAIL=owner@between-days.test
# CLOSED_BETA=true

# 正式运行前填写全部项目。生产环境禁止测试收件箱和 .test 站长邮箱。
# APP_MODE=production
# APP_URL=https://your-domain.example
# AUTH_SECRET=填写随机生成的至少32位密钥
# OWNER_EMAIL=你的真实站长邮箱
# MAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=发信账号
# SMTP_PASS=发信授权码或凭据
# SMTP_FROM=日常之间 <sender@example.com>
# CLOSED_BETA=true
